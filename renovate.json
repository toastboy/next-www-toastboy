{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Renovate is the only dependency updater (Dependabot security updates stay enabled in the repo settings). Minor and patch updates are grouped and auto-merged once the required checks pass; majors are never auto-merged and wait for approval on the Dependency Dashboard; Node.js moves in one grouped PR.",
    "extends": ["config:recommended", ":dependencyDashboard"],
    "enabledManagers": [
        "nvm",
        "npm",
        "dockerfile",
        "github-actions",
        "terraform",
        "custom.regex"
    ],
    "customManagers": [
        {
            "description": "The Node.js major in the Dockerfile's distroless runtime image name, which the dockerfile manager can't bump: track the ARG against Node.js releases",
            "customType": "regex",
            "managerFilePatterns": ["/(^|/)Dockerfile$/"],
            "matchStrings": ["ARG NODE_MAJOR=(?<currentValue>\\d+)\\s"],
            "datasourceTemplate": "node-version",
            "depNameTemplate": "node",
            "versioningTemplate": "node"
        }
    ],
    "minimumReleaseAge": "3 days",
    "internalChecksFilter": "strict",
    "platformAutomerge": true,
    "automergeStrategy": "rebase",
    "postUpdateOptions": ["npmInstallTwice"],
    "vulnerabilityAlerts": { "enabled": true },
    "packageRules": [
        {
            "description": "Minor/patch: one grouped PR, merged when the required checks pass. 0.x is excluded: any bump there can break",
            "matchUpdateTypes": ["minor", "patch", "digest"],
            "matchCurrentVersion": "!/^0\\./",
            "groupName": "non-major",
            "automerge": true
        },
        {
            "description": "Pinning a digest only fixes the image to what the tag points at now: merge it when the required checks pass, in its own PR",
            "matchUpdateTypes": ["pin", "pinDigest"],
            "automerge": true
        },
        {
            "description": "Majors are deliberate: list them on the dashboard, open a PR only when approved there, never auto-merge",
            "matchUpdateTypes": ["major"],
            "dependencyDashboardApproval": true,
            "automerge": false,
            "addLabels": ["major"]
        },
        {
            "description": "Packages that must move together",
            "matchPackageNames": ["eslint", "@eslint/js"],
            "groupName": "eslint-core"
        },
        {
            "matchPackageNames": [
                "eslint-plugin-*",
                "!eslint-plugin-storybook"
            ],
            "groupName": "eslint-plugins"
        },
        {
            "matchPackageNames": ["@mantine/*"],
            "groupName": "mantine"
        },
        {
            "matchPackageNames": [
                "next",
                "@next/eslint-plugin-next",
                "eslint-config-next"
            ],
            "groupName": "next"
        },
        {
            "matchPackageNames": ["@playwright/*"],
            "groupName": "playwright"
        },
        {
            "matchPackageNames": [
                "prisma",
                "@prisma/adapter-mariadb",
                "@prisma/client"
            ],
            "groupName": "prisma"
        },
        {
            "matchPackageNames": ["react", "react-dom", "react-test-renderer"],
            "groupName": "react-core"
        },
        {
            "matchPackageNames": ["@types/react", "@types/react-dom"],
            "groupName": "react-types"
        },
        {
            "matchPackageNames": ["@sentry/*"],
            "groupName": "sentry"
        },
        {
            "matchPackageNames": [
                "storybook",
                "@storybook/*",
                "eslint-plugin-storybook"
            ],
            "groupName": "storybook"
        },
        {
            "matchPackageNames": ["@tiptap/*"],
            "groupName": "tiptap"
        },
        {
            "matchPackageNames": ["@typescript-eslint/*"],
            "groupName": "typescript-eslint"
        },
        {
            "matchPackageNames": ["vitest", "@vitest/*"],
            "groupName": "vitest"
        },
        {
            "description": "distroless tags float (:nonroot), so pin the digest: OS and Node patches then arrive as digest updates that auto-merge",
            "matchPackageNames": ["gcr.io/distroless/**"],
            "pinDigests": true
        },
        {
            "description": "Node.js: one PR moving .nvmrc, engines, @types/node and the Dockerfile together (the workflows follow .nvmrc); LTS (even) majors only",
            "matchDepNames": ["node", "@types/node"],
            "groupName": "Node.js",
            "rangeStrategy": "replace",
            "allowedVersions": "/^v?\\d*[02468](\\.|$)/"
        },
        {
            "description": "Hold TypeScript below 7 (native compiler: no compiler API, which typescript-eslint and Next.js need) until the toolchain supports it",
            "matchPackageNames": ["typescript"],
            "allowedVersions": "<7"
        }
    ]
}
